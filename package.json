{
  "name": "tickets-dev-mcp",
  "version": "0.1.0",
  "license": "MIT",
  "description": "MCP server for live ticket listings, all-in prices and seat maps from Ticketmaster, StubHub, SeatGeek, Vivid Seats, TickPick, Gametime, Viagogo and more. A stdio bridge to the hosted Tickets.dev MCP server.",
  "type": "module",
  "bin": {
    "tickets-dev-mcp": "src/index.js"
  },
  "main": "src/index.js",
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0"
  },
  "keywords": [
    "mcp",
    "model context protocol",
    "tickets",
    "ticketmaster api",
    "stubhub api",
    "seatgeek api",
    "ticket prices",
    "seat maps"
  ],
  "homepage": "https://tickets.dev/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tickets-dot-dev/ai.git"
  },
  "mcpName": "io.github.Tickets-dot-dev/ai"
}
